/* Icon + copy stacked and centered as one unit (Figma about frame) */
.scroll-icons__cluster {
  position: fixed;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translate(-50%, -50%);
  pointer-events: none;
  will-change: left, top;
}

.scroll-icons__silver-fixed {
  display: block;
  height: auto;
  flex-shrink: 0;
  transform-origin: center center;
  mix-blend-mode: lighten;
  will-change: transform, width;
}

.scroll-icons__copy-wrap {
  width: min(1100px, 94vw);
  margin-top: -120px;
  flex-shrink: 0;
  will-change: transform;
}

.scroll-icons__copy-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.scroll-icons__copy {
  margin: 0;
  padding: 0 clamp(20px, 4vw, 40px);
  font-family: var(--font-body), system-ui, sans-serif;
  text-align: center;
  position: relative;
  color: rgba(255, 255, 255, 0.38);
  width: 100%;
  max-width: 100%;
}

.scroll-icons__copy--lead {
  font-size: 48px;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.scroll-icons__copy--body {
  font-size: 20px;
  line-height: 1.45;
  max-width: min(620px, 86vw);
}

.atlas-description-text .word,
.atlas-description-text .atlas-word {
  display: inline-block;
  will-change: transform, color;
}

.atlas-description-text .atlas-word-mask {
  display: inline-block;
  overflow: hidden;
  vertical-align: bottom;
}

@media (prefers-reduced-motion: reduce) {
  .scroll-icons__copy {
    color: #fff;
  }
}

.scroll-icons {
  position: relative;
  height: 280vh;
  background: #0d0d0d;
  margin-top: -1px;
}
